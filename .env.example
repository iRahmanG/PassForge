# ==============================================================================
# PassForge Environment Configuration Template
# ==============================================================================

# Backend Server Port (default: 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed CORS origins (comma-separated or '*' for open access)
CORS_ORIGIN=*

# Frontend API Base URL (used by Vite client in production / staging)
VITE_API_BASE_URL=http://localhost:3000

# Max CSV upload size in bytes (default: 5242880 = 5MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Max CSV rows per import batch (default: 500)
MAX_CSV_ROWS=500
