# ============================================================
# PassForge — .gitignore
# ============================================================

# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/
apps/frontend/dist
apps/backend/dist
coverage/

# --- Generated/local output directories ---
output
apps/backend/output
scratch
screenshots

# --- Local AI coding agent skills and tool configurations ---
# These are locally installed development tools — do NOT commit them.
.agents/
.claude/
.gemini/
.cursor/
.windsurf/

# Skills lockfile (local only)
skills-lock.json
.skills-lock.json
.claude/skills-lock.json

# --- Environment and secrets ---
.env
.env.*
!.env.example
!.env.sample

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# --- Operating system files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editor and temporary files ---
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak

# --- Test and browser artifacts ---
playwright-report/
test-results/
scripts/
docs/screenshots/

docs/ui-polish-report.md
